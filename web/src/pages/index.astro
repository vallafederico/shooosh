---
import "../styles/global.css"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>shooosh — WGSL, WebGPU with WebGL2 fallback</title>
    <meta
      name="description"
      content="WGSL-first site engine. WebGPU when available, WebGL2 when not. Scenes, DOM-tracked items, post-processing."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <section class="hero">
      <canvas id="scene"></canvas>
      <div class="frame">
        <header>
          <span>shooosh</span>
          <nav>
            <a href="https://www.npmjs.com/package/shooosh">npm</a>
            <a href="https://github.com/vallafederico/shooosh">github</a>
          </nav>
        </header>
        <div class="copy">
          <h1>native<br />wgsl / webgpu</h1>
          <p class="lede">
            The engine already running on our sites. WebGPU when the browser
            can, WebGL2 when it can’t. One canvas or a page-behind layer,
            DOM-tracked quads, and a small post stack. Author in WGSL.
          </p>
          <pre>pnpm i shooosh</pre>
        </div>
        <footer>
          <span>0.0.1</span>
          <span>createScene · createItem · acquireLayer</span>
        </footer>
      </div>
    </section>

    <script>
      import { createScene } from "shooosh"

      const fragment = `fn fsMain() -> vec4f {
  let t = uUni.values0.x;
  let p = vUv * 2.0 - 1.0;
  let r = length(p);
  let a = atan2(p.y, p.x);
  let bands = sin(r * 12.0 - t * 1.4 + sin(a * 4.0 + t * 0.7));
  let ink = vec3f(0.047, 0.047, 0.043);
  let acid = vec3f(0.847, 1.0, 0.243);
  let paper = vec3f(0.925, 0.906, 0.863);
  var color = mix(ink, paper, 0.07 + 0.1 * r);
  color = mix(color, acid, smoothstep(0.15, 0.9, bands * 0.5 + 0.5) * (1.0 - r * 0.5));
  return vec4f(color, 1.0);
}
`

      const canvas = document.querySelector<HTMLCanvasElement>("#scene")
      if (canvas) {
        createScene(canvas, {
          screen: {
            shaders: { fragment },
            onFrame(self, frame) {
              self.setUni({ value1: frame.now * 0.001 })
            },
          },
        })
      }
    </script>
  </body>
</html>
