{
  "name": "shooosh-experiment",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "cd .. && bun test experiment/src/text-bench",
    "prepare:font": "cd .. && bun experiment/scripts/text-bench/bake.ts && python3 experiment/scripts/text-bench/pack-runtime.py",
    "audit:startup": "vite build --mode startup-sdf && vite build --mode startup-msdf && vite build --mode startup-slug && cd .. && bun experiment/scripts/audit-startup.ts"
  },
  "dependencies": {
    "shooosh": "workspace:*"
  },
  "devDependencies": {
    "vite": "^7.1.3",
    "typescript": "^5.9.2"
  }
}
